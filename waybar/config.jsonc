{
  "layer": "top",
  "position": "top",
  "autohide": true,
  "autohide-blocked": false,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "modules-left": [
    "custom/archicon",
    "temperature",
    "pulseaudio",
    "custom/music",
    "hyprland/language"
  ],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": ["clock", "memory", "custom/notification", "custom/power"],
  "custom/archicon": {
    "format": "󰣇",
    "on-click": "rofi -show drun -theme ~/.config/rofi/styles/menu.rasi",
    "tooltip": false
  },
  "temperature": {
    "hwmon-path": "/sys/devices/pci0000:00/0000:00:08.1/0000:08:00.0/hwmon/hwmon1/temp1_input",
    "format": "{temperatureC}°C {icon}",
    "tooltip": true,
    "tooltip-format": "Temperature: {temperatureC}°C",
    "format-icons": [""],
    "interval": 5
  },
  "pulseaudio": {
    "format": "{icon} {volume}% ",
    "format-muted": " {format_source}",
    "format-icons": {
      "default": ["", ""]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },
  "custom/music": {
    "exec": "~/.config/waybar/music-player.sh",
    "interval": 2,
    "return-type": "text",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  "hyprland/language": {
    "format": "{} ",
    "on-click": "hyprctl switchxkblayout evision-akko-keyboard next",
    "format-es": "ESP",
    "format-en": "ENG"
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "<span font='12'>󰮯</span>",
      "empty": "<span font='12'>󰊠</span>",
      "default": "<span font='12'></span>"
    },
    "persistent-workspaces": {
      "*": 8
    },
    "disable-scroll": true,
    "all-outputs": true,
    "show-special": true
  },
  "clock": {
    "tooltip": false,
    "format": "{:%I:%M %p | %d-%b-%Y}",
    "timezone": "America/Mexico_City",
    "on-click": "gsimplecal"
  },
  "memory": {
    "format": "{used:0.2f}G | {total:0.2f}G 󰍛"
  },
  "custom/notification": {
    "tooltip": true,
    "format": "<span size='14pt'>{icon}</span>",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "custom/power": {
    "format": "  ",
    "tooltip": false,
    "on-click": "~/.config/rofi/launchers/powermenu.sh",
  }
}
